rules_version = '2';

// Jaay security rules. Every read and write is checked here, on Google's servers,
// so access levels cannot be bypassed from a browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(s) { return /databases/$(database)/documents/stores/$(s)/members/$(request.auth.uid); }
    function isMember(s) {
      return signedIn() && exists(memberPath(s)) && get(memberPath(s)).data.active == true;
    }
    function hasRole(s, roles) { return isMember(s) && get(memberPath(s)).data.role in roles; }
    function isOwner(s) { return hasRole(s, ['owner']); }
    function validRole(r) { return r in ['owner', 'manager', 'cashier', 'stock', 'accountant']; }
    function logPath(s, id) { return /databases/$(database)/documents/stores/$(s)/log/$(id); }
    // Every new record and every change is saved together with a new activity-log entry
    // written by the same person in the same step. Without it, the save is refused.
    function logged(s) {
      return request.resource.data.logId is string
        && !exists(logPath(s, request.resource.data.logId))
        && getAfter(logPath(s, request.resource.data.logId)).data.uid == request.auth.uid;
    }

    // Visit records written by the public website (planetautohub.com). Anyone may add or update THEIR OWN
    // visit record (the id is a random 20-character visit id); nobody but staff can read them. The shape is
    // fixed: only these fields, numbers within range, short strings, short lists, and no back-dated times.
    function validHit(d, id) {
      return d.keys().hasOnly(['sid','vid','day','ts','dur','depth','dev','w','lang','vl','tz','ref','src','nv','secs','clicks'])
        && d.keys().hasAll(['sid','vid','day','ts','dur','depth','dev','w','lang','vl','tz','ref','src','nv','secs','clicks'])
        && d.sid == id && id.size() >= 16 && id.size() <= 24
        && d.vid is string && d.vid.size() >= 8 && d.vid.size() <= 24
        && d.day is string && d.day.size() == 10
        && d.ts is int && d.ts <= request.time.toMillis() + 300000 && d.ts >= request.time.toMillis() - 172800000
        && d.dur is int && d.dur >= 0 && d.dur <= 14400
        && d.depth is int && d.depth >= 0 && d.depth <= 100
        && d.w is int && d.w >= 0 && d.w <= 10000
        && d.dev in ['m','t','d'] && d.lang in ['fr','en']
        && d.vl is string && d.vl.size() <= 10
        && d.tz is string && d.tz.size() <= 40
        && d.ref is string && d.ref.size() <= 60
        && d.src is string && d.src.size() <= 30
        && d.nv is bool
        && d.secs is list && d.secs.size() <= 12
        && d.clicks is list && d.clicks.size() <= 30;
    }

    match /stores/{s} {
      // The sign-in page shows the store's name, logo and contact details.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && s.matches('^[a-z0-9]{3,20}$')
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(s)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isOwner(s));
        allow list: if isOwner(s);
        // The owner adds staff; the person who created the store becomes its first owner.
        allow create: if (isOwner(s)
              && validRole(request.resource.data.role)
              && request.resource.data.active is bool)
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.role == 'owner'
              && request.resource.data.active == true
              && get(/databases/$(database)/documents/stores/$(s)).data.ownerUid == request.auth.uid);
        // An owner cannot demote or deactivate themselves (prevents a store with no owner).
        allow update: if isOwner(s)
          && validRole(request.resource.data.role)
          && request.resource.data.active is bool
          && (uid != request.auth.uid || (request.resource.data.role == 'owner' && request.resource.data.active == true));
        allow delete: if isOwner(s) && uid != request.auth.uid;
      }

      // Activity log: who did what and when. Only the owner can read it. Nobody can change or
      // delete an entry, the time comes from Google's clock, and the name and access level must
      // be the person's own.
      match /log/{id} {
        allow read: if isOwner(s);
        allow create: if isMember(s)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.ts == request.time
          && request.resource.data.name == get(memberPath(s)).data.name
          && request.resource.data.role == get(memberPath(s)).data.role;
        allow update, delete: if false;
      }

      match /items/{id} {
        allow read: if isMember(s);
        allow create, update: if hasRole(s, ['owner', 'manager', 'stock']) && logged(s);
        allow delete: if hasRole(s, ['owner', 'manager', 'stock']);
      }

      match /parties/{id} {
        allow read: if isMember(s);
        allow create, update: if hasRole(s, ['owner', 'manager', 'cashier', 'stock']) && logged(s);
        allow delete: if hasRole(s, ['owner', 'manager']);
      }

      // Recurring bills (rent, salaries) and monthly expense budgets.
      // Cashiers and stock keepers cannot see these figures.
      match /opex/{id} {
        allow read: if hasRole(s, ['owner', 'manager', 'accountant']);
        allow create, update: if hasRole(s, ['owner', 'manager']) && logged(s);
        allow delete: if hasRole(s, ['owner', 'manager']);
      }

      // Deals (discounts applied at the till): everyone in the store reads them; owner and managers set them.
      match /deals/{id} {
        allow read: if isMember(s);
        allow create, update: if hasRole(s, ['owner', 'manager']) && logged(s);
        allow delete: if hasRole(s, ['owner', 'manager']);
      }

      // Customer database: contacts stored 250 per document (crm/l001 loaded list, crm/b001 added in the app).
      // Stock keepers and accountants cannot see it. Contacts are archived, never deleted.
      match /crm/{id} {
        allow read: if hasRole(s, ['owner', 'manager', 'cashier']);
        allow create, update: if hasRole(s, ['owner', 'manager', 'cashier']) && logged(s);
        allow delete: if false;
      }

      // Website visits: staff (owner, manager) read; the public site adds and updates its own record; only the owner deletes.
      match /web_hits/{id} {
        allow read: if hasRole(s, ['owner', 'manager']);
        allow create: if s == 'pah' && validHit(request.resource.data, id);
        allow update: if s == 'pah' && validHit(request.resource.data, id)
          && request.resource.data.vid == resource.data.vid
          && request.resource.data.ts == resource.data.ts
          && request.resource.data.dur >= resource.data.dur;
        allow delete: if isOwner(s);
      }

      match /txns/{id} {
        allow read: if isMember(s);
        allow create: if logged(s)
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.date is string
          && (
               (request.resource.data.type in ['sale', 'quote', 'payin'] && hasRole(s, ['owner', 'manager', 'cashier']))
            || (request.resource.data.type in ['purchase', 'po', 'adjust'] && hasRole(s, ['owner', 'manager', 'stock']))
            || (request.resource.data.type in ['return', 'payout', 'expense'] && hasRole(s, ['owner', 'manager']))
            // Cashiers can only submit expense requests; the owner or a manager approves them.
            || (request.resource.data.type == 'expense' && request.resource.data.status == 'pending' && hasRole(s, ['cashier']))
          );
        allow update: if hasRole(s, ['owner', 'manager']) && logged(s);
        allow delete: if hasRole(s, ['owner', 'manager']);
      }
    }
  }
}
